{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,

    "modules-left": [

    "custom/launcher",

    "hyprland/workspaces",

    "hyprland/submap",

    "custom/sysinfo"
],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [

    "cpu",

    "memory",

    "custom/gpu",

    "custom/fan",

    "pulseaudio",

    "battery",

    "network",

    "clock",

    "tray",

    "custom/notification",

    "custom/power"
],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹",
            "2": "",
            "3": "󰚩",
            "4": "",
            "5": "",
            "default": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "interval": 2,
    "on-click": "hyprctl dispatch exec '[float] kitty -e btop'",
    "on-click-right": "notify-send 'CPU' \"$(grep 'model name' /proc/cpuinfo | head -1 | cut -d':' -f2)\""
},

    "memory": {
    "format": "  {}%",
    "on-click": "hyprctl dispatch exec 'kitty -e btop'"
},

    "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁 Muted",
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀 Connected",
    "format-disconnected": "󰖪 Offline",

    "tooltip-format": "{essid}\n{ipaddr}",

    "on-click": "nm-connection-editor",

    "on-click-right": "nm-connection-editor"
},

    "battery": {

    "states": {
        "warning": 30,
        "critical": 15
    },

    "format": "{icon} {capacity}%",

    "format-charging": "󰂄 {capacity}%",

    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾"
    ],

    "on-click": "xfce4-power-manager-settings",

    "on-click-right": "notify-send Battery \"$(upower -i $(upower -e | grep BAT) | grep time)\""
},

    "clock": {

    "locale":"en_US.UTF-8",

    "format":" {:%I:%M %p}",

    "tooltip-format":"<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>",

    "on-click":"gnome-calendar",

    "on-click-right":"notify-send \"$(date)\""
},
    "tray": {
    "spacing": 10,
    "icon-size": 18
},

    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {0}",
        "format-icons": {
            "notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "hyprctl dispatch exec 'swaync-client -t -sw'",
        "on-click-right": "hyprctl dispatch exec 'swaync-client -d -sw'",
        "escape": true
    },

    "custom/sysinfo": {

    "exec":"~/.config/waybar/sys_info.sh",

    "return-type":"json",

    "interval":2,

    "tooltip":true,

    "on-click":"kitty -e btop",

    "on-click-right":"kitty -e fastfetch"
},

"custom/gpu": {

    "exec":"~/.config/waybar/gpu_info.sh",

    "return-type":"json",

    "interval":2,

    "tooltip":true,

    "on-click":"nvidia-settings",

    "on-click-right":"~/.config/waybar/gpu_notify.sh"
},

"custom/fan": {

    "exec":"~/.config/waybar/fan_control.sh",

    "return-type":"json",

    "interval":2,

    "tooltip":true,

    "on-click":"~/.config/waybar/fan_notify.sh",

    "on-click-right":"~/.config/waybar/msi_fan_mode.sh"
},
"custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu.sh"
},
"custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "walker"
}
}