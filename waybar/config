{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/sysinfo"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "network",
        "clock",
        "tray",
        "custom/notification"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹",
            "2": "",
            "3": "󰚩",
            "4": "",
            "5": "",
            "default": ""
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": false,
        "on-click": "hyprctl dispatch exec 'kitty -e btop'"
    },

    "memory": {
        "format": "  {}%",
        "on-click": "hyprctl dispatch exec 'kitty -e btop'"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰅶  Muted",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "hyprctl dispatch exec pavucontrol" 
    },

    "network": {
        "format-wifi": "   {signalStrength}%",
        "format-ethernet": "󰊗  Connected",
        "format-disconnected": "⚠  Disconnected",
        "on-click": "hyprctl dispatch exec nm-connection-editor"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰃨  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "on-click": "hyprctl dispatch exec xfce4-power-manager-settings"
    },

    "clock": {
        "locale": "en_US.UTF-8",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "  {:%I:%M %p  |  %A, %b %d}"
    },

    "tray": {
        "spacing": 10
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {0}",
        "format-icons": {
            "notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='#eb6f92'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "hyprctl dispatch exec 'swaync-client -t -sw'",
        "on-click-right": "hyprctl dispatch exec 'swaync-client -d -sw'",
        "escape": true
    },

    "custom/sysinfo": {
        "exec": "~/.config/waybar/sys_info.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    }
}